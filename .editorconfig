# EditorConfig — https://editorconfig.org
# shfmt reads the [*.sh] / [zsh/bin/*] section; editors pick up the rest.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

# Windows Terminal writes 4-space JSON (see zsh/bin/wt-settings).
[windows-terminal/settings.json]
indent_size = 4

[*.lua]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# shfmt options (binary_next_line / switch_case_indent match the existing scripts).
[{*.sh,zsh/bin/*}]
binary_next_line = true
switch_case_indent = true
